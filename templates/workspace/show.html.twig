{% extends 'base.html.twig' %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/workspace/show.css') }}">
{% endblock %}

{% block body %}
<div class="mobile-header">
    <div class="burger-container">
        <button id="burgerBtn" class="burger-btn">☰</button>
    </div>

    <h1 class="mobile-title">{{ workspace.title }}</h1>
</div>

<div class="workspace-container">

    <aside class="workspace-aside">
        
        <!-- Titre -->
        <h2 class="workspace-title">
            {{ workspace.title }}
        </h2>

        <!-- Stats tâches -->
        <div class="task-stats">

            {% for column in workspace.columns %}
                <p>
                    <strong>{{ column.title }} :</strong>
                    {{ column.tasks|length }}
                </p>
            {% endfor %}

        </div>

        <!-- Navigation -->
        <nav class="workspace-nav">
            <a href="{{ path('workspace_index') }}">+ Workspaces</a>
            <a href="#">+ Tâches</a>
            <a href="#">+ Paramètres</a>
        </nav>

    </aside>

    <div class="workspace-content">
        <div class="columns-container">

            {% for column in workspace.columns %}
                <div class="column" data-column="{{ column.id }}">

                    <!-- Titre colonne -->
                    <div class="column-header">
                        <h3 class="column-title">{{ column.title }}</h3>
                        <span class="toggle-icon">▼</span>
                    </div>

                    <!-- Cartes -->
                    <div class="tasks">
                        {% for task in column.tasks %}
                            <div class="task-card">

                                {% if task.isImportant %}
                                    <span class="star">⭐</span>
                                {% endif %}

                                {{ task.title }}

                            </div>
                        {% else %}
                            <p class="no-task">Aucune tâche</p>
                        {% endfor %}
                    </div>

                    <!-- Bouton -->
                    <button 
                        class="add-task-btn" 
                        data-column-id="{{ column.id }}"
                    >
                        + Ajouter une tâche
                    </button>

                </div>
            {% else %}
                <p>Aucune colonne pour ce workspace</p>
            {% endfor %}

            <!-- Ajouter colonne -->
            <div class="add-column-container">
                <button class="add-column-btn">+ Ajouter une colonne</button>
            </div>

        </div>
    </div>

</div>

{# Modal d'ajout d'une tâche #}
<div id="taskModal" class="custom-modal">
    <div class="modal-content">

        <h3>Créer une nouvelle tâche</h3>

        {{ form_start(taskForm, { attr: { id: 'taskForm' } }) }}

            <div class="form-group">
                {{ form_label(taskForm.title, "Titre de la tâche") }}
                {{ form_widget(taskForm.title) }}
            </div>

            <div class="form-group">
                {{ form_label(taskForm.description, "Description (optionnelle)") }}
                {{ form_widget(taskForm.description) }}
            </div>

            <div class="form-group checkbox-group">
                {{ form_widget(taskForm.isImportant) }}
                {{ form_label(taskForm.isImportant, "Tâche importante ⭐") }}
            </div>

            <input type="hidden" id="columnId" name="columnId">

            <button type="submit" class="modal-submit-btn">
                Créer la tâche
            </button>

        {{ form_end(taskForm) }}

    </div>
</div>

{% block javascripts %}
    <script src="{{ asset('js/task.js') }}"></script>
{% endblock %}

{% endblock %}